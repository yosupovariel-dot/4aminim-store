generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Managed Postgres (Neon, via Vercel's integration). DATABASE_URL is the
  // pooled connection (used at runtime); DATABASE_URL_UNPOOLED bypasses the
  // pooler and is required for running migrations. Both are auto-populated
  // by Vercel's Neon integration — no extra env vars need to be added there.
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum SetKind {
  REGULAR
  SPECIAL
  // A purchasable add-on that isn't a full four-species set (e.g. spare
  // aravot, since aravot dry out within days and are worth replacing
  // mid-holiday). Uses the same ProductSet/OrderItem plumbing as sets.
  ADDON
}

enum HiddurLevel {
  KOSHER
  MEHADRIN
  MEHADRIN_MIN_HAMEHADRIN
  DIAMOND
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model AdminUser {
  id             String    @id @default(cuid())
  username       String    @unique
  passwordHash   String
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
}

model ProductSet {
  id          String   @id @default(cuid())
  kind        SetKind
  slug        String   @unique
  name        String
  etrogType   String
  hiddurLevel HiddurLevel?
  description String
  price       Int
  // total stock only meaningful for SPECIAL sets; NULL/ignored for REGULAR (unlimited for now)
  stockTotal  Int?
  stockSold   Int      @default(0)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  images      SetMedia[]
  orderItems  OrderItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum MediaType {
  IMAGE
  VIDEO
}

model SetMedia {
  id        String    @id @default(cuid())
  setId     String
  set       ProductSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  type      MediaType
  url       String
  sortOrder Int       @default(0)
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       Int         @unique
  items             OrderItem[]
  totalPrice        Int
  depositAmount     Int
  customerName      String
  phone             String
  neighborhood      String
  address           String
  notes             String?
  depositMarkedPaid Boolean     @default(false)
  depositMarkedAt   DateTime?
  depositConfirmed  Boolean     @default(false)
  depositConfirmedAt DateTime?
  // Customer opted to pay the full amount in cash on delivery instead of
  // transferring a deposit via Bit/PayBox now.
  payFullInCash     Boolean     @default(false)

  termsAccepted     Boolean     @default(false)
  status            OrderStatus @default(PENDING)
  adminNotes        String?

  delivered         Boolean     @default(false)
  deliveredAt       DateTime?

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model OrderItem {
  id                String     @id @default(cuid())
  orderId           String
  order             Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  setId             String
  set               ProductSet @relation(fields: [setId], references: [id])
  setNameSnapshot   String
  etrogTypeSnapshot String
  unitPrice         Int
  quantity          Int
  createdAt         DateTime   @default(now())
}
