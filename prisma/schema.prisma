generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SetKind {
  REGULAR
  SPECIAL
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model AdminUser {
  id             String    @id @default(cuid())
  username       String    @unique
  passwordHash   String
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
}

model ProductSet {
  id          String   @id @default(cuid())
  kind        SetKind
  slug        String   @unique
  name        String
  etrogType   String
  description String
  price       Int
  // total stock only meaningful for SPECIAL sets; NULL/ignored for REGULAR (unlimited for now)
  stockTotal  Int?
  stockSold   Int      @default(0)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  images      SetMedia[]
  orderItems  OrderItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum MediaType {
  IMAGE
  VIDEO
}

model SetMedia {
  id        String    @id @default(cuid())
  setId     String
  set       ProductSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  type      MediaType
  url       String
  sortOrder Int       @default(0)
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       Int         @unique
  items             OrderItem[]
  totalPrice        Int
  depositAmount     Int
  customerName      String
  phone             String
  email             String?
  neighborhood      String
  address           String
  notes             String?
  depositMarkedPaid Boolean     @default(false)
  depositMarkedAt   DateTime?
  depositConfirmed  Boolean     @default(false)
  depositConfirmedAt DateTime?
  termsAccepted     Boolean     @default(false)
  status            OrderStatus @default(PENDING)
  adminNotes        String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model OrderItem {
  id                String     @id @default(cuid())
  orderId           String
  order             Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  setId             String
  set               ProductSet @relation(fields: [setId], references: [id])
  setNameSnapshot   String
  etrogTypeSnapshot String
  unitPrice         Int
  quantity          Int
  createdAt         DateTime   @default(now())
}
